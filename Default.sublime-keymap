// CodeContinue - Key Bindings
[
    // Accept next line of suggestion
    { "keys": ["super+1"], "command": "code_continue_accept",
      "context": [{"key": "setting.code_continue_visible", "operand": "true"}] },

    // Dismiss suggestion / cancel in-flight request
    { "keys": ["escape"], "command": "code_continue_dismiss",
      "context": [{"key": "setting.code_continue_visible", "operand": "true"}] },

    // Manual trigger (works even when auto_trigger is off)
    { "keys": ["ctrl+enter"], "command": "code_continue_suggest" }
]
