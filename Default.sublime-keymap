// CodeContinue - Key Bindings
[
    // ── Inline phantom suggestion ─────────────────────────────────────────────
    // Accept next line (Tab)
    {
        "keys": [
            "tab"
        ],
        "command": "code_continue_accept",
        "context": [
            {
                "key": "setting.code_continue_visible",
                "operand": true
            }
        ]
    },
    // Dismiss (ESC) — falls through to Sublime's ESC when no suggestion
    {
        "keys": [
            "escape"
        ],
        "command": "code_continue_dismiss",
        "context": [
            {
                "key": "setting.code_continue_visible",
                "operand": true
            }
        ]
    },
    // ── Popup suggestion ──────────────────────────────────────────────────────
    // Accept popup (Tab or Enter)
    {
        "keys": [
            "tab"
        ],
        "command": "code_continue_accept_popup",
        "context": [
            {
                "key": "setting.code_continue_popup_visible",
                "operand": true
            }
        ]
    },
    {
        "keys": [
            "enter"
        ],
        "command": "code_continue_accept_popup",
        "context": [
            {
                "key": "setting.code_continue_popup_visible",
                "operand": true
            }
        ]
    },
    // Dismiss popup (ESC) — Sublime's built-in backspace/editing still works
    {
        "keys": [
            "escape"
        ],
        "command": "code_continue_dismiss_popup",
        "context": [
            {
                "key": "setting.code_continue_popup_visible",
                "operand": true
            }
        ]
    },
    // ── Manual trigger ────────────────────────────────────────────────────────
    {
        "keys": [
            "ctrl+enter"
        ],
        "command": "code_continue_suggest"
    }
]