// CodeContinue - Key Bindings
[
    // ── Inline phantom ────────────────────────────────────────────────────────
    {
        "keys": [
            "tab"
        ],
        "command": "code_continue_accept",
        "context": [
            {
                "key": "setting.code_continue_visible",
                "operand": true
            }
        ]
    },
    {
        "keys": [
            "escape"
        ],
        "command": "code_continue_dismiss",
        "context": [
            {
                "key": "setting.code_continue_visible",
                "operand": true
            }
        ]
    },
    // ── Popup (Tab/Enter handled by on_text_command, only ESC needs binding) ──
    {
        "keys": [
            "escape"
        ],
        "command": "code_continue_dismiss_popup",
        "context": [
            {
                "key": "setting.code_continue_popup_visible",
                "operand": true
            }
        ]
    },
    // ── Manual trigger ────────────────────────────────────────────────────────
    {
        "keys": [
            "ctrl+enter"
        ],
        "command": "code_continue_suggest"
    }
]