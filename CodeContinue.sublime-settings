{
    // ── Connection ────────────────────────────────────────────────────────────
    //
    // OpenAI-compatible chat completions endpoint.
    // For Ollama use: http://localhost:11434/v1/chat/completions
    //
    "endpoint": "http://localhost:11434/v1/chat/completions",

    // Model name — exactly as shown by `ollama list`
    "model": "qwen2.5-coder:3b",

    // API key — Ollama doesn't check it but the v1 endpoint requires the
    // field, so any non-empty string works for local use.
    "api_key": "ollama",

    // ── Generation parameters ─────────────────────────────────────────────────
    //
    // Low temperature = deterministic pattern completion.
    // Raise slightly (0.3-0.4) if completions feel too rigid.
    "temperature": 0.2,
    "top_p": 0.9,

    // Maximum tokens per suggestion. 200 is enough for 4-5 lines of code.
    // No stop sequences are used — max_tokens is the only length limit.
    "max_tokens": 200,

    // ── Context ───────────────────────────────────────────────────────────────
    //
    // Total code lines around the cursor sent to the model.
    // ⅔ from before the cursor, ⅓ after.
    // 60 is good for 3b models. Larger models can handle 80-100.
    "max_context_lines": 60,

    // Request timeout in ms. Increase for slow models or cold starts.
    "timeout_ms": 30000,

    // ── Project context (Rust only) ───────────────────────────────────────────
    //
    // When true, scans neighboring .rs files in the same directory and
    // extracts function/struct/enum signatures for use as model context.
    //
    // Useful for cross-file completions (calling a function from another module),
    // but adds noise for small models. Off by default.
    //
    // Note: sibling file *names* (the "modules in same directory" list) are
    // ALWAYS sent regardless of this setting — they're cheap and critical for
    // mod.rs files.
    "index_neighboring_files": false,

    // ── Language triggers ─────────────────────────────────────────────────────
    //
    // Match against file extension (without dot) AND Sublime syntax name.
    // Empty array = enabled for all file types.
    //
    "trigger_language": [
        "rs", "py", "js", "ts", "tsx", "jsx",
        "go", "java", "kt", "cpp", "cc", "c", "h", "hpp",
        "sql", "toml", "yaml", "yml",
        "sh", "bash", "json", "html", "css", "scss"
    ],

    // ── Debug ─────────────────────────────────────────────────────────────────
    // When true, logs every request to View > Show Console.
    // Includes the raw model response — invaluable for diagnosing bad output.
    "debug": false
}
